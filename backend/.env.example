# Set to production when deploying
NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
# Use the same DATABASE_URL value in development and production.
# For Neon, paste the full connection string here.
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/mesob_wellness?schema=public

# Optional overrides if you want explicit DB_* values in local development.
# If omitted, the app derives them from DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your_postgres_password
# DB_NAME=mesob_wellness

# JWT Configuration
JWT_SECRET=mesob_jwt_local_2026_strong_key
JWT_EXPIRES_IN=1h

# Optional: Connection Pool Settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT=30000

# Email Configuration (Resend)
# Sign up at https://resend.com for free tier (3,000 emails/month)
# Get your API key from: https://resend.com/api-keys
# 
# TESTING: Use onboarding@resend.dev (can only send to your registered email)
# PRODUCTION: Verify your domain at https://resend.com/domains, then use noreply@yourdomain.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Redis Configuration (for email job queue)
# Set REDIS_ENABLED=false for local development if Redis is not running
# DEVELOPMENT: You can use the same Upstash Redis as production
# OR run local Redis with Docker: docker run -d -p 6379:6379 redis:alpine
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Facility Name (appears on referral letters)
FACILITY_NAME=MESOB Wellness Center



